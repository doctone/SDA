# Variables read by the app and worker. docker-compose.yml sets these for
# every container, so no .env file is needed to run the stack.
DATABASE_URL=postgres://skills:skills@postgres:5432/skills
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=hn-ingestion

# Hosted services use the same database, namespace, and task queue.
# DATABASE_URL=<Neon pooled URL with SSL parameters>
# TEMPORAL_ADDRESS=quickstart-doctone-sda.rozg0.tmprl.cloud:7233
# TEMPORAL_NAMESPACE=quickstart-doctone-sda.rozg0
# TEMPORAL_TASK_QUEUE=hn-ingestion-production
# TEMPORAL_API_KEY=<set privately in Vercel and Render; enables TLS>
